{
	"name": "@fusengine/fusecli",
	"version": "1.0.10",
	"description": "Generate production-ready CLIs from any OpenAPI spec — built for AI agents",
	"type": "module",
	"license": "Apache-2.0",
	"author": "Bruno Azoulay <bruno@fusengine.ch> (https://fusengine.ch)",
	"repository": {
		"type": "git",
		"url": "https://github.com/fusengine/fusecli.git",
		"directory": "packages/cli"
	},
	"homepage": "https://github.com/fusengine/fusecli#readme",
	"bugs": "https://github.com/fusengine/fusecli/issues",
	"keywords": [
		"openapi",
		"cli",
		"generator",
		"openapi-generator",
		"cli-generator",
		"swagger",
		"rest-api",
		"api-client",
		"typescript",
		"ai-agents",
		"code-generator",
		"devtools",
		"bun"
	],
	"main": "dist/index.js",
	"bin": {
		"fusecli": "dist/index.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"bun": ">=1.2.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "bun build src/index.ts --outfile dist/index.js --target bun",
		"dev": "bun run src/index.ts",
		"test": "bun test",
		"lint": "bunx biome check .",
		"compile": "bun build src/index.ts --compile --outfile dist/fusecli",
		"prepublishOnly": "bun run build"
	},
	"dependencies": {
		"commander": "^14.0.3",
		"picocolors": "^1.1.1",
		"yaml": "^2.8.3",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.9",
		"@types/bun": "^1.3.11",
		"typescript": "^6.0.2"
	}
}
